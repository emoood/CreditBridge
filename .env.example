APP_ENV=development
DEMO_MODE=true
DEV_CONSOLE=true
DATABASE_URL=
DOCUMENT_ROOT=./data/documents
LLM_DEFAULT_ROUTE=gemini
LLM_ALLOW_FALLBACK=true
LLM_FALLBACK_ROUTE=mac_dev
MATCHER_MAX_TOOL_ROUNDS=6
REVIEWER_MAX_TOOL_ROUNDS=6
LLM_CONTEXT_TOKENS=8192
LLM_TEMPERATURE=0
OLLAMA_MAC_URL=http://127.0.0.1:11434
OLLAMA_MAC_DEV_MODEL=qwen3.5:4b
OLLAMA_MAC_QUALITY_MODEL=qwen3.5:9b
OLLAMA_HOME_URL=http://127.0.0.1:11435
OLLAMA_HOME_MODEL=qwen3.5:9b
LLM_CALL_TIMEOUT_SECONDS=120
# Google Gemini route: set LLM_DEFAULT_ROUTE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional LM Studio route: set LLM_DEFAULT_ROUTE=lmstudio and the model id shown in LM Studio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
# Target catalog: demo (synthetic) or aud_2026_2027 (real AUD catalog, descriptions only, no outcomes)
CATALOG=aud_2026_2027
# Agent protocol: native (runtime tool calls) or json_action (constrained JSON actions; needs structured output support)
AGENT_PROTOCOL=native
APP_DATABASE_URL=postgresql+psycopg:///creditbridge
